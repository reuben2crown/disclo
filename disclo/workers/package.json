{
  "name": "@disclo/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:scan": "node dist/scan/scan-orchestrator-worker.js",
    "start:text": "node dist/classify/text-classifier-worker.js",
    "start:image": "node dist/classify/image-classifier-worker.js",
    "start:claims": "node dist/classify/claims-checker-worker.js",
    "start:report": "node dist/reports/report-generator-worker.js",
    "start:evidence": "node dist/evidence/evidence-verifier-worker.js",
    "start:auto-scan": "node dist/maintenance/auto-scan-worker.js",
    "smoke:bullmq": "tsx src/smoke/bullmq-smoke.ts"
  },
  "dependencies": {
    "@disclo/core": "workspace:*",
    "@disclo/db": "workspace:*",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.0",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
