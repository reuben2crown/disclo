    "db:seed": "prisma db seed",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.20.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "@types/node": "^22.10.2"
  }
