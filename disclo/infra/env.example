# Core
# Supabase: use **one** `DATABASE_URL` (transaction pooler, port 6543) for the app and Prisma Client.
# For `prisma migrate deploy`, set `DIRECT_URL` to the **Session mode** or **direct** string from Supabase
# (Project Settings → Database). Do not duplicate `DATABASE_URL` in the same file; the last line wins.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Session/direct connection for migrations only (not PgBouncer transaction mode).
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Upstash Redis URL (rediss://default:password@host:port). If this instance is shared with
# other apps, BullMQ keys are still isolated: the app sets BullMQ prefix `disclo_` on every queue/worker.
REDIS_URL=rediss://default:password@host:6379
ENCRYPTION_KEY=
APP_URL=https://your-app.up.railway.app
NODE_ENV=development
# UI default when no `disclo_locale` cookie and Accept-Language is missing or unsupported.
# Allowed: en fr es de it pt nl ja ko zh pl sv da tr ru
DEFAULT_LOCALE=en

# Detection APIs
GPTZERO_API_KEY=
HIVE_API_KEY=
ANTHROPIC_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=compliance@disclo.com

# Dodo Payments (non-Shopify billing)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test

# R2 (evidence uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Shopify embedded app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_content,read_themes,write_themes
SHOPIFY_APP_URL=https://your-app.up.railway.app
# Optional: second Shopify app on same machine — set theme port if 9293 is taken; set localhost port only if you need a fixed app port (Shopify CLI may prompt for localhost TLS).
# SHOPIFY_DEV_THEME_APP_EXTENSION_PORT=9294
# SHOPIFY_DEV_LOCALHOST_PORT=3001
# SHOPIFY_VITE_HMR_PORT=65000

SESSION_SECRET=
# Workers (BE-19): Bearer for POST {SHOPIFY_APP_URL}/internal/monthly-scan (Shopify Remix app); set on Railway worker + app services.
INTERNAL_API_SECRET=
LOG_LEVEL=info

# Optional: email merchants see when something fails on the server and they need help from the app owner
MERCHANT_SUPPORT_EMAIL=

# Optional support/monitoring hooks
SUPPORT_ALERT_WEBHOOK_URL=
SENTRY_DSN=
POSTHOG_API_KEY=
