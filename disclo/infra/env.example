# Core
# Supabase Postgres: prefer **Transaction pooler** (port 6543) for serverless/Railway; direct `db.*.supabase.co:5432`
# often fails from cloud hosts (IPv6 / firewall). If `prisma migrate deploy` returns P1001, switch URL in Supabase dashboard.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
# Upstash Redis URL (rediss://default:password@host:port)
REDIS_URL=rediss://default:password@host:6379
ENCRYPTION_KEY=
APP_URL=https://your-app.up.railway.app
NODE_ENV=development

# Detection APIs
GPTZERO_API_KEY=
HIVE_API_KEY=
ANTHROPIC_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=compliance@disclo.com

# Dodo Payments (non-Shopify billing)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test

# R2 (evidence uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Shopify embedded app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_content,read_themes,write_themes
SHOPIFY_APP_URL=https://your-app.up.railway.app

SESSION_SECRET=
INTERNAL_API_SECRET=
LOG_LEVEL=info

# Optional support/monitoring hooks
SUPPORT_ALERT_WEBHOOK_URL=
SENTRY_DSN=
POSTHOG_API_KEY=
